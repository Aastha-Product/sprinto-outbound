# Copy this file to .env   (PowerShell:  Copy-Item .env.example .env)   then fill in the values.
# .env is gitignored. NEVER share it or paste it into chat.
# Put values right after "=" with no spaces and no quotes.

# ---------- Owner / sender ----------
# The ONLY address emails are ever sent to
OWNER_EMAIL=you@gmail.com
SENDER_NAME=Anshull Mishra
SENDER_TITLE=Growth at Sprinto

# ---------- Google Gemini ----------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Run:  python scripts\list_models.py   and paste a current "flash" model name here
GEMINI_MODEL=
# Let the agent loop use Google Search through Gemini
USE_SEARCH_GROUNDING=true

# ---------- Hunter.io ----------
# Get a key: https://hunter.io/api-keys   (free plan: 25 searches/month)
HUNTER_API_KEY=
# Stop calling Hunter when fewer searches than this remain
HUNTER_MIN_REMAINING=3

# ---------- Gmail API ----------
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
# Must be true AND you must pass --send for an email to actually go out
SEND_ENABLED=false
MAX_EMAILS_PER_RUN=3
# Only needed on Vercel (no token.json there). Filled in during Phase 5.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---------- Neon Postgres ----------
# Vercel sets this automatically when you add Neon under Storage. Copy the same value here to use Neon locally.
# Leave empty to store results as files in runs/ and .cache/ instead.
DATABASE_URL=

# ---------- Public website limits (all visitors together, counted in Neon) ----------
MAX_EMAILS_PER_DAY=5
MAX_RUNS_PER_DAY=20

# ---------- Pipeline limits ----------
MAX_PAGES_PER_DOMAIN=6
MAX_CHARS_PER_PAGE=8000
MAX_AGENT_ITERATIONS=3
MAX_LLM_CALLS_PER_DOMAIN=12
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=MESA-Student-Research-Bot/0.1 (educational project)
